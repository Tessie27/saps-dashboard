---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SapsSection from '../components/SapsSection.astro';
import GenderSection from '../components/GenderSection.astro';
import StationTable from '../components/StationTable.astro';
import Footer from '../components/Footer.astro';
import sapsData from '../data/saps.json';

const srcLine = `SAPS source: ${sapsData.meta.source}  -  ${sapsData.meta.file} | Coverage: ${sapsData.meta.coverage} | ${sapsData.meta.station_count} stations. Gender data: Stats SA P0341, Victims of Crime Survey 2025/26.`;
---
<Layout title="South Africa Crime Dashboard">
  <nav class="side-nav" id="sideNav">
    <div class="side-nav-title">Jump to</div>
    <a href="#kpiRow">Overview</a>
    <a href="#mapCard">Hotspot map</a>
    <a href="#trendCard">National trend</a>
    <a href="#provCard">Province &amp; category</a>
    <a href="#genderSection">Gender breakdown</a>
    <a href="#stationTable">Station leaderboard</a>
  </nav>
  <button id="backToTop" aria-label="Back to top">↑ Top</button>
  <div class="wrap">
    <Header srcLine={srcLine} />

    <div class="filter-bar">
      <div class="filter-bar-row">
        <span class="filter-bar-label">Province:</span>
        <span class="filter-bar-value" id="filterProvinceLabel">All provinces</span>
        <button class="clearbtn" id="filterProvClear" style="display:none;">Clear</button>
      </div>
      <div class="filter-bar-row">
        <span class="filter-bar-label">Year(s):</span>
        <div class="year-picker" id="yearPicker"></div>
        <button class="clearbtn" id="yearReset">Latest year only</button>
      </div>
    </div>

    <div class="kpi-row" id="kpiRow"></div>

    <SapsSection />

    <GenderSection />

    <StationTable />

    <Footer firstYear={sapsData.years[0]} latestYear={sapsData.meta.latest_year} />
  </div>
</Layout>

<script>
  import '../scripts/dashboard.js';
</script>
